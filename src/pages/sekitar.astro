const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Apakah Pantai Kuta termasuk area memorial?", "acceptedAnswer": {"@type": "Answer", "text": "Tidak. Indonesia.travel mencantumkan Pantai Kuta sebagai tujuan tersendiri. Alamat, akses, kondisi pantai, dan transportasinya perlu diperiksa secara terpisah."}}, {"@type": "Question", "name": "Apakah ada jalur langsung ke Pantai Legian?", "acceptedAnswer": {"@type": "Answer", "text": "Pantai Legian dapat dipertimbangkan sebagai tujuan terpisah, tetapi panduan ini belum memverifikasi jalur penghubung, jarak berjalan, atau kondisi akses dari memorial. Jangan menganggap ada koridor langsung."}}, {"@type": "Question", "name": "Apakah fasilitas sekitar dijamin tersedia?", "acceptedAnswer": {"@type": "Answer", "text": "Tidak. Untuk makan, toilet, ATM, penginapan, bahan bakar, atau pengisian kendaraan, periksa lokasi dan jam layanan penyedia. Kami tidak memastikan fasilitas tersebut tersedia di memorial."}}, {"@type": "Question", "name": "Apakah satu izin atau biaya mencakup tujuan sekitar?", "acceptedAnswer": {"@type": "Answer", "text": "Tidak ada tiket gabungan, biaya, atau izin lintas tempat yang kami verifikasi. Konfirmasikan setiap tujuan dan layanan secara terpisah sebelum berangkat."}}]};
