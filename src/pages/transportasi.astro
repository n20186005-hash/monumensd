const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Di mana tujuan yang perlu disebutkan kepada pengemudi?", "acceptedAnswer": {"@type": "Answer", "text": "Sebut Monumen Ground Zero Bali, Jalan Legian, Kuta, Badung, Bali 80361. Pin peta yang diperiksa 19 Oktober 2026 adalah -8.7172698, 115.17449; rute dan titik turun tetap perlu dikonfirmasi."}}, {"@type": "Question", "name": "Bagaimana merencanakan perjalanan dari bandara?", "acceptedAnswer": {"@type": "Answer", "text": "Tanyakan kepada penyedia transportasi tentang layanan yang tersedia, aturan zona jemput, tarif, serta titik turun menuju Jalan Legian. Panduan ini tidak menetapkan rute, layanan, atau durasi perjalanan tertentu."}}, {"@type": "Question", "name": "Apakah ada parkir atau rute berjalan kaki yang dipastikan?", "acceptedAnswer": {"@type": "Answer", "text": "Parkir khusus, fasilitas aksesibilitas, dan jalur pejalan kaki terus-menerus belum kami verifikasi. Periksa kondisi serta rambu; jangan menganggap titik pin sebagai izin kendaraan berhenti atau masuk ke memorial."}}, {"@type": "Question", "name": "Apakah dapat datang malam hari?", "acceptedAnswer": {"@type": "Answer", "text": "Jam operasional tidak tercantum pada Google Maps yang diperiksa 19 Oktober 2026. Konfirmasikan akses sebelum perjalanan, terutama jika datang setelah gelap. Tidak ada jaminan akses 24 jam."}}]};
