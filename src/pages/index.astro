---
import BaseLayout from "../layouts/BaseLayout.astro";
import Facts from "../components/Facts.astro";
import Faq from "../components/Faq.astro";
import TopicLinks from "../components/TopicLinks.astro";
import {
  SITE_NAME,
  withSiteName,
  MONUMENT_NAME,
  MONUMENT_FORMAL_NAME,
  MONUMENT_ALTERNATE_NAMES,
  RATING_LABEL,
  RATING_CHECKED,
  RATING_VALUE,
  RATING_COUNT,
  MONUMENT_ADDRESS,
  MONUMENT_MAP_URL,
  MONUMENT_LAT,
  MONUMENT_LNG,
  MONUMENT_PLUS_CODE,
} from "../data/site";

const metaTags = {
  title: withSiteName("Sejarah, Lokasi & Cara ke Sana"),
  description:
    "Panduan independen Monumen Ground Zero Bali (Monumen Tragedi Kemanusiaan) di Jalan Legian, Kuta: sejarah 12 Oktober 2002, lokasi, cara ke sana, dan sekitar. Bukan situs resmi.",
};

const facts: [string, string][] = [
  [RATING_LABEL, RATING_CHECKED],
  ["Jalan Legian, Kuta, Badung, Bali", "Lokasi"],
  ["Monumen peringatan terbuka", "Jenis"],
  [MONUMENT_PLUS_CODE, "Plus Code"],
];

const faqs = [
  { q: "Di mana letak monumen ini?", a: "Monumen berada di Jalan Legian, Kuta, Kabupaten Badung, Bali 80361, Indonesia. Gunakan peta untuk rute." },
  { q: "Berapa jam buka monumen?", a: "Data peta yang diperiksa tidak mencantumkan jam operasional resmi. Verifikasi akses di lokasi." },
  { q: "Berapa biaya masuk?", a: "Tidak ada tarif resmi yang tercantum pada data peta. Waspadai penawaran tiket tak resmi." },
  { q: "Boleh membawa anak?", a: "Ya, asalkan diajarkan menjaga ketenangan dan menghormati ruang memori." },
  { q: "Apakah aman dikunjungi?", a: "Kuta adalah kawasan wisata yang beroperasi. Ikuti petunjuk setempat dan informasi resmi perjalanan." },
];
---

<BaseLayout
  title={metaTags.title}
  description={metaTags.description}
  lang="id"
  alternates={[
    { hreflang: "id", href: new URL(Astro.url.pathname, (Astro.site ?? "https://monumensd.com/").toString().replace(/\/$/, "") + "/").toString() },
    { hreflang: "en", href: new URL("/en/", (Astro.site ?? "https://monumensd.com/").toString().replace(/\/$/, "") + "/").toString() },
    { hreflang: "x-default", href: new URL(Astro.url.pathname, (Astro.site ?? "https://monumensd.com/").toString().replace(/\/$/, "") + "/").toString() },
  ]}
>
  <main id="konten">
    <section class="section-shell hero" id="atas">
      <p class="kicker">{MONUMENT_FORMAL_NAME}</p>
      <h1>{MONUMENT_NAME}</h1>
      <p class="lead">{MONUMENT_NAME} adalah monumen peringatan di Jalan Legian, Kuta, yang mengenang korban tragedi 12 Oktober 2002. Panduan ini membantu Anda memahami sejarah, menemukan lokasi, merencanakan kunjungan yang hormat, dan menjelajahi kawasan Kuta di sekitarnya.</p>
      <Facts facts={facts} />
    </section>

    <section class="section-shell intro" id="tentang">
      <h2>Tentang monumen ini</h2>
      <p>{MONUMENT_NAME} berada di koridor Jalan Legian, Kuta, Kabupaten Badung, Bali. Ia bukan objek wisata hiburan, melainkan ruang memori terbuka yang menghormati korban, penyintas, dan keluarga yang ditinggalkan.</p>
      <div class="info-grid">
        <div><h3>Apa</h3><p>Monumen peringatan untuk tragedi 12 Oktober 2002 di kawasan Legian–Kuta.</p></div>
        <div><h3>Di mana</h3><p>Jalan Legian, Kuta, Kabupaten Badung, Bali 80361. <a href={MONUMENT_MAP_URL} target="_blank" rel="noopener">Buka di Google Maps</a>.</p></div>
        <div><h3>Mengapa</h3><p>Mengenang 202 korban dari 22 negara dan merawat pesan perdamaian lintas bangsa.</p></div>
        <div><h3>Menghormati</h3><p>Kunjungi dengan tenang. Jangan menaiki struktur atau memindahkan bunga peringatan.</p></div>
      </div>
      <p class="note">Panduan independen pihak ketiga. Bukan situs resmi monumen, dan tidak mewakili pemerintah daerah atau pengelola.</p>
    </section>

    <section class="section-shell map" id="peta">
      <h2>Peta &amp; lokasi</h2>
      <p>Gunakan koordinat atau pin peta berikut untuk menuju monumen. Pastikan pengemudi memahami bahwa monumen ada di Kuta, bukan Denpasar. <a href="/koordinat-dan-lokasi">Cara menyebutkan alamat ke pengemudi →</a></p>
      <iframe title="Peta lokasi monumen" src={`https://maps.google.com/maps?q=${MONUMENT_LAT},${MONUMENT_LNG}&z=17&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <p class="addr">{MONUMENT_ADDRESS}</p>
    </section>

    <section class="section-shell info" id="kunjungan">
      <h2>Persiapan kunjungan</h2>
      <div class="info-grid">
        <div><h3>Jam kunjungan</h3><p>Data peta yang diperiksa tidak mencantumkan jam resmi. Verifikasi akses di lokasi. <a href="/jam-kunjungan">Selengkapnya →</a></p></div>
        <div><h3>Biaya masuk</h3><p>Tidak ada tarif resmi yang tercantum. Waspadai penawaran tak resmi. <a href="/biaya-masuk">Selengkapnya →</a></p></div>
        <div><h3>Aksesibilitas</h3><p>Koridor perkotaan; fasilitas akses belum terverifikasi. <a href="/aksesibilitas-monumen">Selengkapnya →</a></p></div>
        <div><h3>Etika</h3><p>Jaga ketenangan, foto dengan rasa hormat, jangan ganggu prasasti. <a href="/etika-berkunjung">Selengkapnya →</a></p></div>
      </div>
    </section>

    <section class="section-shell history" id="sejarah-ringkas">
      <h2>Sejarah &amp; makna</h2>
      <p>Monumen ini berkaitan dengan tragedi 12 Oktober 2002 di Legian–Kuta. Indonesia.travel mencatat 202 korban dari 22 negara. Bagian tengah monumen menyerupai gunungan wayang, simbol perdamaian lintas bangsa.</p>
      <ul class="inline-links">
        <li><a href="/sejarah">Sejarah lengkap →</a></li>
        <li><a href="/bom-bali-2002">Bom Bali I 2002 →</a></li>
        <li><a href="/makna-monumen-perdamaian">Makna monumen →</a></li>
        <li><a href="/bom-bali-denpasar-2002">Bedakan lokasi Denpasar →</a></li>
        <li><a href="/peringatan-12-oktober">Peringatan 12 Oktober →</a></li>
      </ul>
    </section>

    <section class="section-shell transport" id="transportasi-ringkas">
      <h2>Transportasi</h2>
      <p>Monumen berada di koridor Jalan Legian yang aktif. Rencanakan transfer dari bandara atau Denpasar dengan penyedia terverifikasi, dan verifikasi parkir serta rute.</p>
      <ul class="inline-links">
        <li><a href="/transportasi">Transportasi lengkap →</a></li>
        <li><a href="/dari-bandara-ngurah-rai">Dari bandara Ngurah Rai →</a></li>
        <li><a href="/dari-denpasar">Dari Denpasar →</a></li>
        <li><a href="/parkir-sekitar-kuta">Parkir di Kuta →</a></li>
      </ul>
    </section>

    <section class="section-shell nearby" id="sekitar">
      <h2>Kawasan sekitar</h2>
      <p>Setelah mengenang, Anda dapat melanjutkan ke Pantai Kuta, Beachwalk, Poppies Lane, atau taman air. Semua tujuan terpisah; verifikasi masing-masing.</p>
      <ul class="inline-links">
        <li><a href="/sekitar">Sekitar lengkap →</a></li>
        <li><a href="/pantai-kuta">Pantai Kuta →</a></li>
        <li><a href="/beachwalk-kuta">Beachwalk →</a></li>
        <li><a href="/poppies-lane">Poppies Lane →</a></li>
        <li><a href="/itinerary-sehari">Itinerari sehari →</a></li>
      </ul>
    </section>

    <TopicLinks lang="id" />

    <section class="section-shell faq" id="faq">
      <h2>Tanya jawab</h2>
      <Faq items={faqs} />
    </section>

    <section class="section-shell sources" id="sumber">
      <h2>Sumber &amp; verifikasi</h2>
      <ul class="source-list">
        <li><a href="https://www.indonesia.travel" target="_blank" rel="noopener">Indonesia.travel — informasi pariwisata resmi</a></li>
        <li><a href={MONUMENT_MAP_URL} target="_blank" rel="noopener">Google Maps — data lokasi &amp; penilaian publik (diperiksa 28 Oktober 2026)</a></li>
        <li>Pemerintah Kabupaten Badung — laporan doa lintas agama 12 Oktober 2026 (catatan masa lalu)</li>
      </ul>
      <p class="note">Informasi jam, tarif, dan layanan dapat berubah. Verifikasi di lokasi atau dengan penyedia resmi sebelum berangkat.</p>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["TouristAttraction", "LandmarksOrHistoricalBuildings", "Place"],
        "@id": "https://monumensd.com/#attraction",
        name: MONUMENT_FORMAL_NAME,
        alternateName: MONUMENT_ALTERNATE_NAMES,
        description: "Monumen peringatan di Jalan Legian, Kuta, Bali, yang mengenang korban tragedi 12 Oktober 2002.",
        address: { "@type": "PostalAddress", streetAddress: "Jalan Legian, Kuta", addressLocality: "Kuta", addressRegion: "Bali", postalCode: "80361", addressCountry: "ID" },
        geo: { "@type": "GeoCoordinates", latitude: MONUMENT_LAT, longitude: MONUMENT_LNG },
        aggregateRating: { "@type": "AggregateRating", ratingValue: RATING_VALUE, reviewCount: RATING_COUNT, bestRating: 5 },
        isAccessibleForFree: true,
        sameAs: [MONUMENT_MAP_URL],
      },
      {
        "@type": "WebSite",
        "@id": "https://monumensd.com/#website",
        url: "https://monumensd.com/",
        name: SITE_NAME,
        inLanguage: "id",
      },
      {
        "@type": "Organization",
        "@id": "https://monumensd.com/#organization",
        name: SITE_NAME,
        url: "https://monumensd.com/",
      },
      {
        "@type": "WebPage",
        "@id": "https://monumensd.com/#webpage",
        url: "https://monumensd.com/",
        name: metaTags.title,
        description: metaTags.description,
        inLanguage: "id",
        about: { "@id": "https://monumensd.com/#attraction" },
        isPartOf: { "@id": "https://monumensd.com/#website" },
      },
      {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Beranda", item: "https://monumensd.com/" },
        ],
      },
    ],
  })} />
</BaseLayout>
