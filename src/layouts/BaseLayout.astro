---
/**
 * 设计提醒：布局保持“石碑与静默”的克制、单语印尼语与石材阅读感；不使用通用旅游推广口吻。
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME } from "../data/site";

interface Alt { hreflang: string; href: string; }
interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  lang?: string;
  alternates?: Alt[];
}

const { title, description, image, noIndex = false, lang = "id", alternates } = Astro.props;
const configuredSite = Astro.site?.toString().replace(/\/$/, "");
const canonical = configuredSite && !noIndex ? new URL(Astro.url.pathname, `${configuredSite}/`).toString() : undefined;
const shareImage = configuredSite && image ? new URL(image, `${configuredSite}/`).toString() : undefined;
const resolvedAlternates: Alt[] = alternates && alternates.length
  ? alternates
  : canonical
    ? [{ hreflang: "id", href: canonical }, { hreflang: "x-default", href: canonical }]
    : [];
const ogLocale = lang === "en" ? "en_US" : "id_ID";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151617" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex,follow" />}
    {resolvedAlternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#konten">{lang === "en" ? "Skip to content" : "Lewati ke isi utama"}</a>
    <Header lang={lang as "id" | "en"} />
    <slot />
    <Footer lang={lang as "id" | "en"} />
    <script is:inline src="/consent.js"></script>
  </body>
</html>
