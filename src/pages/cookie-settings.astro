---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Pengaturan Kuki | Monumen Ground Zero Bali" description="Izinkan atau tolak Google Analytics opsional pada perangkat ini.">
<main id="konten" class="legal-page"><h1>Pengaturan Kuki</h1><p class="legal-date">21 Oktober 2026</p><p class="legal-lede">Google Analytics nonaktif secara bawaan. Pilihan ini hanya mengendalikan Google Analytics pada peramban ini. Peta Google dan pengukuran kinerja hosting Cloudflare adalah layanan terpisah; pengaturan ini tidak menonaktifkannya.</p><form id="cookie-form" class="cookie-form"><fieldset><legend>Google Analytics opsional</legend><p>Izinkan Google Analytics mengukur penggunaan situs. Tidak ada pilihan pemasaran atau akun pengguna.</p><label><input type="checkbox" id="analytics-consent" /> Izinkan Google Analytics</label></fieldset><button type="submit" class="button button-dark">Simpan pilihan</button><button type="button" id="reject-all" class="text-button">Tolak / tarik izin Google Analytics</button><p id="cookie-status" role="status" aria-live="polite"></p></form><p><a href="/privacy-policy">Baca Kebijakan Privasi</a></p></main>
<script is:inline>
(() => {
  const key = 'memorial-cookie-preferences';
  const form = document.getElementById('cookie-form');
  const checkbox = document.getElementById('analytics-consent');
  const status = document.getElementById('cookie-status');
  const deniedKey = 'memorial-analytics-denied';
  try { checkbox.checked = sessionStorage.getItem(deniedKey) !== '1' && JSON.parse(localStorage.getItem(key) || '{}')?.analytics === true; } catch { checkbox.checked = false; }
  function denyForSession() {
    window.__memorialAnalyticsDenied = true;
    window['ga-disable-G-HXM22WWPKP'] = true;
    try { sessionStorage.setItem(deniedKey, '1'); return true; } catch { return false; }
  }
  function save(value) {
    let sessionDenied = false, saved = false;
    if (!value) sessionDenied = denyForSession();
    try {
      if (value) {
        // Clear the tab veto before publishing a shared grant. If this fails,
        // other tabs must not receive an allowance that this form rejects.
        sessionStorage.removeItem(deniedKey);
        if (sessionStorage.getItem(deniedKey) === '1') throw new Error('Tab denial remains active');
        // The runtime must be able to read the choice before it is shared.
        localStorage.getItem(key);
      }
      localStorage.setItem(key, JSON.stringify({ analytics: value }));
      if (value) {
        window.__memorialAnalyticsDenied = false;
      }
      checkbox.checked = value;
      saved = true;
    } catch {
      sessionDenied = denyForSession() || sessionDenied;
      checkbox.checked = false;
      status.textContent = sessionDenied
        ? 'Google Analytics dinonaktifkan untuk tab ini, termasuk saat berpindah halaman atau memuat ulang. Pilihan permanen tidak dapat disimpan; pilihan lama mungkin masih tersimpan. Hapus data situs melalui pengaturan peramban untuk menarik izin tersimpan.'
        : 'Google Analytics dinonaktifkan pada halaman ini. Penyimpanan pilihan tidak tersedia; hapus data situs melalui pengaturan peramban sebelum berpindah atau memuat ulang.';
    }
    window.dispatchEvent(new Event('memorial:consent'));
    if (saved) status.textContent = checkbox.checked
      ? 'Google Analytics diizinkan pada peramban ini.'
      : value
        ? 'Google Analytics tetap nonaktif pada halaman ini karena pilihan tersimpan tidak dapat dibaca. Hapus data situs melalui pengaturan peramban sebelum berpindah atau memuat ulang.'
        : 'Google Analytics ditolak pada peramban ini.';
  }
  form.addEventListener('submit', event => { event.preventDefault(); save(checkbox.checked === true); });
  document.getElementById('reject-all').addEventListener('click', () => save(false));
})();
</script></BaseLayout>
