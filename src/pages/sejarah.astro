---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import TopicLinks from "../components/TopicLinks.astro";
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Peristiwa apa yang diperingati?", "acceptedAnswer": {"@type": "Answer", "text": "Monumen Ground Zero di Jalan Legian, Kuta, mengenang korban Bom Bali I pada 12 Oktober 2002. Indonesia.travel menyebut 202 korban dari 22 negara."}}, {"@type": "Question", "name": "Apa yang dijelaskan sumber tentang bentuk monumen?", "acceptedAnswer": {"@type": "Answer", "text": "Indonesia.travel menjelaskan bentuk gunungan wayang dan prasasti nama serta kewarganegaraan korban. Keduanya mendukung fungsi memorial sebagai tempat mengenang dan pesan perdamaian."}}, {"@type": "Question", "name": "Apakah ada jadwal doa bersama?", "acceptedAnswer": {"@type": "Answer", "text": "Pemerintah Badung melaporkan doa lintas agama pada 12 Oktober 2026. Itu catatan kegiatan yang telah berlangsung, bukan jaminan acara rutin atau akses pada tanggal mendatang."}}, {"@type": "Question", "name": "Bagaimana memberi penghormatan?", "acceptedAnswer": {"@type": "Answer", "text": "Jaga suara, hormati orang yang sedang mengenang, dan ikuti petunjuk di lokasi. Jangan menaiki struktur, memindahkan bunga, atau menghalangi prasasti."}}]};
---
<BaseLayout title="Sejarah Monumen Ground Zero Bali (Monumen Tragedi Kemanusiaan)" description="Konteks Bom Bali 2002, nama korban, dan makna memorial di Jalan Legian, Kuta." image="/bali-memorial-jonathan-liem.jpg">
<main id="konten" class="legal-page"><a class="legal-back" href="/">← Kembali ke panduan</a><p class="kicker">Panduan independen · Kuta</p><h1>Sejarah Monumen Ground Zero Bali <small>(Monumen Tragedi Kemanusiaan)</small></h1><p class="legal-lede">Konteks Bom Bali 2002, nama korban, dan makna memorial di Jalan Legian, Kuta.</p>
