---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Pengaturan Kuki | Monumen Ground Zero Bali" description="Izinkan atau tolak Google Analytics opsional pada perangkat ini.">
<main id="konten" class="legal-page"><h1>Pengaturan Kuki</h1><p class="legal-date">19 Oktober 2026</p><p class="legal-lede">Analitik nonaktif secara bawaan. Pilihan disimpan hanya pada peramban ini; peta Google di beranda adalah layanan terpisah.</p><form id="cookie-form" class="cookie-form"><fieldset><legend>Analitik opsional</legend><p>Izinkan Google Analytics mengukur penggunaan situs. Tidak ada pilihan pemasaran atau akun pengguna.</p><label><input type="checkbox" id="analytics-consent" /> Izinkan Google Analytics</label></fieldset><button type="submit" class="button button-dark">Simpan pilihan</button><button type="button" id="reject-all" class="text-button">Tolak / tarik izin analitik</button><p id="cookie-status" role="status" aria-live="polite"></p></form><p><a href="/privacy-policy">Baca Kebijakan Privasi</a></p></main>
<script is:inline>
(() => {
  const key = 'memorial-cookie-preferences';
  const form = document.getElementById('cookie-form');
  const checkbox = document.getElementById('analytics-consent');
  const status = document.getElementById('cookie-status');
  const deniedKey = 'memorial-analytics-denied';
  try { checkbox.checked = sessionStorage.getItem(deniedKey) !== '1' && JSON.parse(localStorage.getItem(key) || '{}')?.analytics === true; } catch { checkbox.checked = false; }
  function denyForSession() {
    window.__memorialAnalyticsDenied = true;
    window['ga-disable-G-HXM22WWPKP'] = true;
    try { sessionStorage.setItem(deniedKey, '1'); return true; } catch { return false; }
  }
  function save(value) {
    let sessionDenied = false;
    if (!value) sessionDenied = denyForSession();
    try {
      localStorage.setItem(key, JSON.stringify({ analytics: value }));
      if (value) {
        sessionStorage.removeItem(deniedKey);
        window.__memorialAnalyticsDenied = false;
      }
      checkbox.checked = value;
      status.textContent = value ? 'Analitik diizinkan pada peramban ini.' : 'Analitik ditolak pada peramban ini.';
    } catch {
      sessionDenied = denyForSession() || sessionDenied;
      checkbox.checked = false;
      status.textContent = sessionDenied
        ? 'Analitik dinonaktifkan untuk tab ini, termasuk saat berpindah halaman atau memuat ulang. Pilihan permanen tidak dapat disimpan; pilihan lama mungkin masih tersimpan. Hapus data situs melalui pengaturan peramban untuk menarik izin tersimpan.'
        : 'Analitik dinonaktifkan pada halaman ini. Penyimpanan pilihan tidak tersedia; hapus data situs melalui pengaturan peramban sebelum berpindah atau memuat ulang.';
    }
    window.dispatchEvent(new Event('memorial:consent'));
  }
  form.addEventListener('submit', event => { event.preventDefault(); save(checkbox.checked === true); });
  document.getElementById('reject-all').addEventListener('click', () => save(false));
})();
</script></BaseLayout>