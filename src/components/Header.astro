---
interface Props { lang?: "id" | "en"; }
const { lang = "id" } = Astro.props;
const home = lang === "en" ? "/en/" : "/";
const en = lang === "en";
---
<header class="site-header" id="atas">
<a class="wordmark" href={home}><span><strong>{en ? "Bali Ground Zero Memorial" : "Monumen Ground Zero Bali"}</strong><small>{en ? "Independent guide · Kuta" : "Panduan independen · Kuta"}</small></span></a>
<nav aria-label="Navigasi utama">
<a href={en ? "/sejarah" : "/sejarah"}>{en ? "History" : "Sejarah"}</a>
<a href={home + "#kunjungan"}>{en ? "Visit" : "Kunjungan"}</a>
<a href={en ? "/transportasi" : "/transportasi"}>{en ? "Transport" : "Transportasi"}</a>
<a href={en ? "/sekitar" : "/sekitar"}>{en ? "Around" : "Sekitar"}</a>
<a href={home + "#faq"}>{en ? "FAQ" : "Tanya jawab"}</a>
</nav>
<a class="nav-action" href={home + "#peta"}>{en ? "View map ↓" : "Lihat peta ↓"}</a></header>
