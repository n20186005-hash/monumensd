{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monumensd",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash"
  },
  "main": "src/worker.ts"
}
